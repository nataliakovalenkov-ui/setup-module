const byId = Object.fromEntries(S.map(s => [s.id, s]));
const START = '3249';
const stage = document.getElementById('stage'), shot = document.getElementById('shot');
const pick = document.getElementById('pick'), count = document.getElementById('count');
const hotBtn = document.getElementById('hot'), bar = document.getElementById('bar');
let cur = null, flashT = null;

// Screen picker grouped by section
const groups = {};
S.forEach(s => { const g = s.id === START ? 'Overview' : s.name.split(' – ')[0]; (groups[g] = groups[g] || []).push(s); });
for (const [g, list] of Object.entries(groups)) {
  const og = document.createElement('optgroup'); og.label = g;
  list.forEach(s => { const o = document.createElement('option'); o.value = s.id; o.textContent = s.id === START ? 'Setup hub' : s.name.split(' – ').slice(1).join(' › '); og.appendChild(o); });
  pick.appendChild(og);
}

const preloaded = new Set();
function preload(id){ if (preloaded.has(id) || !byId[id]) return; preloaded.add(id); const i = new Image(); i.src = byId[id].img; }

function render(id){
  const s = byId[id] || byId[START];
  cur = s;
  shot.src = s.img; shot.alt = s.name; shot.width = 1440; shot.height = s.h;
  stage.querySelectorAll('.hs').forEach(n => n.remove());
  const frag = document.createDocumentFragment();
  s.hs.forEach(([x,y,w,h,t]) => {
    const a = document.createElement('a');
    a.className = 'hs' + (w*h > 1e6 ? ' bd' : '');
    a.href = '#s' + t;
    a.setAttribute('aria-label', byId[t] ? byId[t].name : t);
    a.style.cssText = `left:${x/14.4}%;top:${y/s.h*100}%;width:${w/14.4}%;height:${h/s.h*100}%`;
    frag.appendChild(a);
    preload(t);
  });
  stage.appendChild(frag);
  pick.value = s.id;
  count.textContent = (S.indexOf(s)+1) + ' / ' + S.length;
  document.title = 'Setup Module Prototype';
  window.scrollTo(0,0);
}

function idFromHash(){ const m = location.hash.match(/^#s(\d+)$/); return m && byId[m[1]] ? m[1] : START; }
window.addEventListener('hashchange', () => render(idFromHash()));
render(idFromHash());

// Click on a non-hotspot area: flash the clickable areas, like a Figma prototype
stage.addEventListener('click', e => {
  if (e.target.closest('.hs')) return;
  stage.classList.add('flash'); clearTimeout(flashT);
  flashT = setTimeout(() => stage.classList.remove('flash'), 450);
});

pick.addEventListener('change', () => { location.hash = 's' + pick.value; });
document.getElementById('home').onclick = () => { location.hash = 's' + START; };
document.getElementById('back').onclick = () => { if (history.length > 1) history.back(); else location.hash = 's' + START; };
function toggleHot(){ const on = !stage.classList.contains('show'); stage.classList.toggle('show', on); hotBtn.setAttribute('aria-pressed', on); }
hotBtn.onclick = toggleHot;
document.getElementById('min').onclick = function(){ const m = bar.classList.toggle('min'); this.innerHTML = m ? '&#9776;' : '&#8211;'; this.setAttribute('aria-label', m ? 'Expand controls' : 'Collapse controls'); };
document.addEventListener('keydown', e => {
  if (e.target.tagName === 'SELECT') return;
  if (e.key === 'h' || e.key === 'H') toggleHot();
  else if (e.key === 'Backspace') { e.preventDefault(); history.back(); }
  else if (e.key === 'Home') location.hash = 's' + START;
});
